# Copy to .env and fill in. Generate secrets with:
#   openssl rand -hex 32     (INTERNAL_KEY, ENCRYPTION_KEY)
#   openssl rand -base64 48  (JWT_SECRET)
INTERNAL_KEY=
JWT_SECRET=
ENCRYPTION_KEY=

# mock = offline demo model (does not really solve tasks).
# Real AI: anthropic | openai | gemini | groq | openrouter | ollama | openai_compatible
# FREE options: gemini (key from aistudio.google.com), groq (console.groq.com), ollama (local, no key).
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
OLLAMA_MODEL=
# Any OpenAI-compatible server (vLLM, LM Studio, ...)
OPENAI_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
# Cheaper model for easy steps (classify, summarize). Empty = use the main model.
LLM_FAST_MODEL=

# Semantic search: auto = real if a key exists, else offline hash. openai | gemini | ollama = real embeddings.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Reranker for search and chat: auto = Cohere-compatible API below if set, else the LLM; none = off.
RERANK_PROVIDER=auto
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
# Optional OpenTelemetry traces (pip install -e ".[trace]")
OTLP_ENDPOINT=

# docker = isolated containers (recommended). subprocess = dev only, NOT isolated.
SANDBOX=docker

WEB_ORIGIN=http://localhost:8080
PUBLIC_API_URL=http://localhost:4000

# Optional: enables POST /webhooks/github (label an issue "devforge" to start a task)
GITHUB_WEBHOOK_SECRET=

# Social sign-in (optional). Leave empty to keep them disabled.
# Redirect/callback URLs to register:
#   Google : http://127.0.0.1:4000/api/auth/oauth/google/callback  (npm run dev) - for Docker use http://localhost:4000/...
#   GitHub : http://127.0.0.1:4000/api/auth/oauth/github/callback   (create an OAuth App, not a GitHub App)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
