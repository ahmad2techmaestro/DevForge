# Shared secret between API and agent (required in production)
INTERNAL_KEY=change-me
# anthropic | openai | mock  (mock = deterministic offline mode)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4.1
# Workspace root: repos/ runs/ checkpoints.sqlite
WORKDIR=./data
# docker | subprocess | auto
SANDBOX=auto
DOCKER_PYTHON_IMAGE=python:3.13-slim
DOCKER_NODE_IMAGE=node:22-slim
MAX_AGENT_ITERATIONS=25
MAX_TOKENS_PER_RUN=500000
COMMAND_TIMEOUT_SECONDS=120
